{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "Bun をランタイムにするパッケージ向け。bun init の既定に合わせてある。.ts 拡張子の import を許可し、実行は Bun に任せる。",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
