{
  "name": "@orpc-prac/contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "default": "./dist/openapi.js"
    }
  },
  "scripts": {
    "build": "pnpm check:type && tsc --build && pnpm lint:openapi",
    "check:type": "tsc --noEmit -p .",
    "lint:openapi": "node scripts/lint-openapi.ts",
    "preview": "node scripts/preview.ts"
  },
  "dependencies": {
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/valibot": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@orpc-prac/tsconfig": "workspace:*",
    "@stoplight/spectral-core": "catalog:",
    "@stoplight/spectral-rulesets": "catalog:",
    "@types/swagger-ui-dist": "catalog:",
    "swagger-ui-dist": "catalog:",
    "typescript": "catalog:"
  }
}
