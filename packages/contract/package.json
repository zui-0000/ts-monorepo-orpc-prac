{
  "name": "@orpc-prac/contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "default": "./dist/openapi.js"
    }
  },
  "scripts": {
    "build": "pnpm lint:fix && tsc --build && pnpm build:openapi",
    "build:openapi": "node scripts/build-openapi.ts",
    "check:type": "tsc --noEmit -p .",
    "check:lint": "oxlint -c .oxlintrc.jsonc",
    "format:check": "oxfmt --check src scripts",
    "format:fix": "oxfmt src scripts",
    "lint:fix": "pnpm check:lint --fix && pnpm format:fix && pnpm check:type",
    "preview": "echo 'Swagger UI: http://localhost:4000' && docker compose up"
  },
  "dependencies": {
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/valibot": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@orpc-prac/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
