{
  "name": "@orpc-prac/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "check:type": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "bun db/migrate.ts",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts",
    "check:lint": "oxlint -c .oxlintrc.jsonc",
    "format:check": "oxfmt --check src db",
    "format:fix": "oxfmt src db",
    "lint:fix": "pnpm check:lint --fix && pnpm format:fix && pnpm check:type"
  },
  "dependencies": {
    "@orpc-prac/contract": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "better-result": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@orpc-prac/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  }
}
