{
  "name": "@orpc-prac/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "check:type": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "bun db/migrate.ts",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts",
    "check:lint": "oxlint -c .oxlintrc.jsonc",
    "check:deps": "depcruise src --config .dependency-cruiser.mjs --output-type err-long",
    "test": "bun test",
    "format:check": "oxfmt --check src db",
    "format:fix": "oxfmt src db",
    "lint:fix": "pnpm check:lint --fix && pnpm format:fix && pnpm check:type && pnpm check:deps"
  },
  "dependencies": {
    "@orpc-prac/contract": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "better-auth": "catalog:",
    "better-result": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@orpc-prac/typescript-config": "workspace:*",
    "@swc/core": "catalog:",
    "@types/bun": "catalog:",
    "dependency-cruiser": "catalog:",
    "drizzle-kit": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  }
}
