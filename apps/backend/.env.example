# docker-compose.yaml の Postgres に合わせた開発用接続情報。
# 実ファイルは .env にコピーして使う (.env は .gitignore 済み)。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orpc_prac

# better-auth がセッションの署名と暗号化に使う鍵。
# **開発でも必ず自分で生成すること** (この例の値をそのまま使わない)。
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# better-auth が絶対 URL (メールのリンク、OAuth の戻り先) を組み立てる基点。
BETTER_AUTH_URL=http://localhost:3000
