{
  "name": "@orpc-prac/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm lint:fix && vite build",
    "preview": "vite preview",
    "check:type": "tsc --noEmit",
    "check:lint": "oxlint -c .oxlintrc.jsonc",
    "format:check": "oxfmt --check src",
    "format:fix": "oxfmt src",
    "lint:fix": "pnpm check:lint --fix && pnpm format:fix && pnpm check:type"
  },
  "dependencies": {
    "@orpc-prac/contract": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "better-auth": "catalog:",
    "better-result": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "catalog:",
    "uuidv7": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@orpc-prac/typescript-config": "workspace:*",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "msw": "catalog:",
    "oxc-transform-react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "vite": "catalog:"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
