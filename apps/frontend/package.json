{
  "name": "@orpc-prac/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm lint:fix && vite build",
    "preview": "vite preview",
    "check:type": "tsc --noEmit",
    "check:lint": "oxlint -c .oxlintrc.jsonc",
    "format:check": "oxfmt --check src",
    "format:fix": "oxfmt src",
    "lint:fix": "pnpm check:lint --fix && pnpm format:fix && pnpm check:type"
  },
  "dependencies": {
    "@orpc-prac/contract": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@orpc-prac/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "vite": "catalog:"
  }
}
